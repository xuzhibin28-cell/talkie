<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct browsing of protected application directories
    RewriteRule ^(app|config|storage|views)(\/.*)?$ - [F,L]

    # If the requested file exists in public/, serve it directly
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/talkie/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/talkie/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Otherwise route all requests to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# Block access to hidden dotfiles and sensitive files
<FilesMatch "^\.env|^\.git|composer\.(json|lock)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

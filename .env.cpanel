# ==============================================================================
# cPanel Production Environment Configuration for Walkie-Talkie PWA
# Rename this file to `.env` on your cPanel server.
# ==============================================================================

# Application Environment (production disables detailed stack traces for security)
APP_NAME="Walkie Talkie PWA"
APP_ENV=production
APP_DEBUG=false

# ------------------------------------------------------------------------------
# APP_URL & APP_BASE_PATH Configuration for cPanel:
#
# Case 1: Deploying to a Subdomain or Main Domain Root (e.g. https://talkie.yourdomain.com/):
#   APP_URL="https://talkie.yourdomain.com"
#   APP_BASE_PATH=""
#
# Case 2: Deploying to a Subfolder in public_html (e.g. https://yourdomain.com/talkie/):
#   APP_URL="https://yourdomain.com/talkie"
#   APP_BASE_PATH="/talkie"
# ------------------------------------------------------------------------------
APP_URL="https://yourdomain.com"
APP_BASE_PATH=""

# Secret key for HMAC-SHA256 session and signaling token signing
# IMPORTANT: Generate a unique random string for production!
SIGNAL_SECRET=cpanel_prod_secret_walkie_talkie_k9x7m2q8v5p1

# Maximum peers allowed per channel (2-8)
SIGNAL_MAX_PEERS=8

# Floor timeout: max time a user can hold PTT floor in milliseconds (30000 = 30 seconds)
SIGNAL_FLOOR_TIMEOUT_MS=30000

# Peer inactivity timeout before auto-removal in milliseconds (15000 = 15 seconds)
SIGNAL_PEER_TIMEOUT_MS=15000

# Rate limit: max requests per minute per IP for signaling
RATE_LIMIT_PER_MINUTE=180

# Payload limits in bytes
SIGNAL_MAX_BODY=32768
SIGNAL_MAX_DATA=12288

# Centralized WebRTC ICE STUN/TURN Servers (JSON format)
# Note: Google STUN servers work free across standard networks.
# If operating over strict cellular symmetric NAT, specify your TURN server below.
ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"},{"urls":"stun:stun2.l.google.com:19302"}]'

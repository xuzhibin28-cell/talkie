APP_NAME="Walkie Talkie PWA"
APP_ENV=local
APP_DEBUG=true
APP_URL="http://localhost/talkie"
APP_BASE_PATH="/talkie"

# Secret key for HMAC-SHA256 session and signaling token signing (Change in production!)
SIGNAL_SECRET=walkie_talkie_secret_key_change_in_production_998877

# Maximum peers allowed per channel (2-8)
SIGNAL_MAX_PEERS=8

# Floor timeout: max time a user can hold PTT floor in milliseconds (30000 = 30 seconds)
SIGNAL_FLOOR_TIMEOUT_MS=30000

# Peer inactivity timeout before auto-removal in milliseconds (15000 = 15 seconds)
SIGNAL_PEER_TIMEOUT_MS=15000

# Rate limit: max requests per minute per IP for signaling
RATE_LIMIT_PER_MINUTE=180

# Payload limits in bytes
SIGNAL_MAX_BODY=32768
SIGNAL_MAX_DATA=12288

# ICE Servers (STUN/TURN) - JSON array
ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"},{"urls":"stun:stun2.l.google.com:19302"}]'
